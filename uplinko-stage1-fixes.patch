diff --git a/backend/src/common/bootstrap-credentials.spec.ts b/backend/src/common/bootstrap-credentials.spec.ts
new file mode 100644
index 0000000..f832f70
--- /dev/null
+++ b/backend/src/common/bootstrap-credentials.spec.ts
@@ -0,0 +1,93 @@
+/**
+ * S3 — secure first-boot admin credentials.
+ *
+ * Proves there is no hardcoded default: an operator value is used as-is, a
+ * legacy "admin123" is refused, an unset value yields a cryptographically
+ * random one-time secret written 0600, the secret is REUSED on later boots
+ * (not regenerated → no reset-on-restart), and clearing it after the first
+ * password change makes it one-time.
+ */
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import {
+  resolveBootstrapPassword,
+  clearBootstrapPassword,
+  generatePassword,
+  INSECURE_DEFAULTS,
+  bootstrapCredFile,
+} from './bootstrap-credentials';
+
+let tmpDir: string;
+const OLD_ENV = process.env;
+
+beforeEach(() => {
+  tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'uplinko-boot-'));
+  process.env = { ...OLD_ENV };
+  process.env.BOOTSTRAP_CRED_FILE = path.join(tmpDir, 'bootstrap-credentials.json');
+  delete process.env.PLATFORM_ADMIN_PASSWORD;
+  delete process.env.ADMIN_PASSWORD;
+});
+afterEach(() => {
+  process.env = OLD_ENV;
+  try { fs.rmSync(tmpDir, { recursive: true, force: true }); } catch { /* ignore */ }
+});
+
+describe('bootstrap credentials (S3)', () => {
+  it('uses an operator-set env password as-is and writes no file', () => {
+    process.env.PLATFORM_ADMIN_PASSWORD = 'My$trongOne';
+    const r = resolveBootstrapPassword('platform', 'PLATFORM_ADMIN_PASSWORD');
+    expect(r).toMatchObject({ password: 'My$trongOne', source: 'env' });
+    expect(fs.existsSync(bootstrapCredFile())).toBe(false);
+  });
+
+  it('treats a legacy insecure default as unset and generates instead', () => {
+    expect(INSECURE_DEFAULTS.has('admin123')).toBe(true);
+    process.env.PLATFORM_ADMIN_PASSWORD = 'admin123';
+    const r = resolveBootstrapPassword('platform', 'PLATFORM_ADMIN_PASSWORD');
+    expect(r.source).toBe('generated');
+    expect(r.password).not.toBe('admin123');
+    expect(r.password.length).toBeGreaterThanOrEqual(20);
+  });
+
+  it('generates a random secret, persists it 0600, and reuses it next boot', () => {
+    const first = resolveBootstrapPassword('platform', 'PLATFORM_ADMIN_PASSWORD');
+    expect(first.source).toBe('generated');
+    expect(first.persisted).toBe(true);
+    // File is 0600.
+    const mode = fs.statSync(bootstrapCredFile()).mode & 0o777;
+    expect(mode).toBe(0o600);
+    // A second resolve (next boot) REUSES the same value — no new secret, no reset.
+    const second = resolveBootstrapPassword('platform', 'PLATFORM_ADMIN_PASSWORD');
+    expect(second.source).toBe('file');
+    expect(second.password).toBe(first.password);
+  });
+
+  it('keeps separate secrets per scope', () => {
+    const p = resolveBootstrapPassword('platform', 'PLATFORM_ADMIN_PASSWORD');
+    const c = resolveBootstrapPassword('company', 'ADMIN_PASSWORD');
+    expect(p.password).not.toBe(c.password);
+    // Both persisted in the one file.
+    const store = JSON.parse(fs.readFileSync(bootstrapCredFile(), 'utf8'));
+    expect(Object.keys(store).sort()).toEqual(['company', 'platform']);
+  });
+
+  it('clears a secret after first password change (one-time use)', () => {
+    resolveBootstrapPassword('platform', 'PLATFORM_ADMIN_PASSWORD');
+    resolveBootstrapPassword('company', 'ADMIN_PASSWORD');
+    clearBootstrapPassword('platform');
+    const store = JSON.parse(fs.readFileSync(bootstrapCredFile(), 'utf8'));
+    expect('platform' in store).toBe(false);
+    expect('company' in store).toBe(true);
+    // After the other is cleared too, the file is removed entirely.
+    clearBootstrapPassword('company');
+    expect(fs.existsSync(bootstrapCredFile())).toBe(false);
+  });
+
+  it('generatePassword returns URL-safe high-entropy strings', () => {
+    const a = generatePassword();
+    const b = generatePassword();
+    expect(a).not.toBe(b);
+    expect(a).toMatch(/^[A-Za-z0-9_-]{20,}$/);
+  });
+});
diff --git a/backend/src/common/bootstrap-credentials.ts b/backend/src/common/bootstrap-credentials.ts
new file mode 100644
index 0000000..6fbf9b2
--- /dev/null
+++ b/backend/src/common/bootstrap-credentials.ts
@@ -0,0 +1,126 @@
+/**
+ * FIRST-BOOT ADMIN CREDENTIALS — NO HARDCODED DEFAULT (S3).
+ *
+ * The platform (SUPER_ADMIN) and the first company (ADMIN) need a password the
+ * very first time the database comes up with no users. Shipping a known default
+ * (`admin123`) meant every fresh install was briefly reachable by anyone who
+ * read the README — and the privileged platform account had no env requirement
+ * at all, so it stayed on the default indefinitely.
+ *
+ * Instead:
+ *   • If the operator set a password in the environment, that is used.
+ *   • Otherwise a cryptographically random password is GENERATED ONCE and
+ *     written to a 0600 credentials file (dir 0700). The operator reads it from
+ *     that file; it is never printed to the application log on every restart.
+ *   • The same resolved value is reused on later boots (read back from the
+ *     file), so the account is NOT reset — and no NEW secret is minted — each
+ *     time the process restarts.
+ *   • `mustChangePassword` forces a change at first sign-in, and once that
+ *     happens the entry is cleared from the file (`clearBootstrapPassword`), so
+ *     the bootstrap secret is strictly one-time.
+ *
+ * The password value lives only in the file and the (hashed) user row — never
+ * in logs, never in an API response.
+ */
+import * as crypto from 'crypto';
+import * as fs from 'fs';
+import * as path from 'path';
+
+/** A known legacy default we must never mint a new account on. */
+export const INSECURE_DEFAULTS = new Set(['admin123', 'password', 'changeme', '']);
+
+/** Where the generated bootstrap secrets are kept (0600). */
+export function bootstrapCredFile(): string {
+  if (process.env.BOOTSTRAP_CRED_FILE) return process.env.BOOTSTRAP_CRED_FILE;
+  const dir = process.env.UPLINKO_STATE_DIR || '/var/lib/jointbox';
+  return path.join(dir, 'bootstrap-credentials.json');
+}
+
+type Store = Record<string, string>;
+
+function readStore(): Store {
+  try {
+    const raw = fs.readFileSync(bootstrapCredFile(), 'utf8');
+    const parsed = JSON.parse(raw);
+    return parsed && typeof parsed === 'object' ? parsed : {};
+  } catch {
+    return {};
+  }
+}
+
+/** Write the store with locked-down permissions. Returns false if it could not. */
+function writeStore(store: Store): boolean {
+  const file = bootstrapCredFile();
+  try {
+    fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });
+    fs.writeFileSync(file, JSON.stringify(store, null, 2), { mode: 0o600 });
+    // Re-assert on overwrite — writeFileSync does not re-chmod an existing file.
+    fs.chmodSync(file, 0o600);
+    try {
+      fs.chmodSync(path.dirname(file), 0o700);
+    } catch {
+      /* dir may be shared (e.g. /var/lib/jointbox) — file perms are what matter */
+    }
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/** A URL-safe 24-character random password (~144 bits). */
+export function generatePassword(): string {
+  return crypto.randomBytes(18).toString('base64url');
+}
+
+export type BootstrapResolution = {
+  password: string;
+  /** 'env' = operator-provided; 'file' = reused generated; 'generated' = new this boot. */
+  source: 'env' | 'file' | 'generated';
+  /** When generated: whether it was persisted to the file (false = could not write). */
+  persisted?: boolean;
+  /** The file it was (or should have been) written to. */
+  file?: string;
+};
+
+/**
