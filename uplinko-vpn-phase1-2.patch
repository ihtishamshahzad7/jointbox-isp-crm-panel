--- /dev/null
+++ b/backend/src/nas/l2tp-client-dialer.service.ts
@@ -0,0 +1,313 @@
+import { Injectable, Logger } from '@nestjs/common';
+import { promises as fs } from 'fs';
+import { execFile } from 'child_process';
+
+/**
+ * L2tpClientDialer — brings up the panel's OUTBOUND L2TP/IPsec client tunnel to
+ * a NAS public IP, using the host's strongSwan (swanctl, IKEv1 PSK) + xl2tpd +
+ * pppd.  DIRECTION: Uplinko panel (client) → NAS public IP (server).
+ *
+ * The daemons actually LOAD and OPERATE what we write:
+ *   • strongSwan: per-NAS config + secrets go into a swanctl conf.d directory,
+ *     then `swanctl --load-all` loads them; `swanctl --initiate` dials; status
+ *     comes from `swanctl --list-sas --ike <name>` for THIS connection only;
+ *     `swanctl --terminate --ike <name>` tears it down.
+ *   • xl2tpd: the LAC is added to the RUNNING daemon with `xl2tpd-control add`,
+ *     dialed with `connect`, read back with `status <lac>`, and removed on
+ *     teardown — no orphaned unused files.
+ *
+ * SAFETY
+ *   • Secrets (PSK, PPP password) live only in 0600 files inside a 0700 dir;
+ *     permissions are re-asserted on every write, including overwrites.
+ *   • All inputs are validated before any file write or command.
+ *   • "connected" requires a matching IPsec SA AND the LAC's own ppp interface
+ *     to be operationally UP — never an arbitrary ppp device, never "config saved".
+ *   • Partial tunnels are cleaned up on every error/timeout path.
+ *   • All host commands go through an injected runner, so this is unit-testable
+ *     and a host missing the tooling degrades to a clear error.
+ */
+
+export type DialState = 'disconnected' | 'connecting' | 'connected' | 'error';
+
+export interface DialParams {
+  connectionId: string; // stable per-NAS id, e.g. "nas-42"
+  server: string; // NAS public IP / hostname the panel dials
+  ipsecPsk: string;
+  pppUsername: string;
+  pppPassword: string;
+  localAddress?: string;
+  timeoutSec?: number;
+  retryCount?: number;
+  retryDelaySec?: number;
+}
+
+export interface DialStatus {
+  state: DialState;
+  interface?: string | null;
+  localAddress?: string | null;
+  remoteAddress?: string | null;
+  ipsec?: 'established' | 'connecting' | 'down' | null;
+  l2tp?: 'up' | 'down' | null;
+  detail?: string | null;
+  error?: string | null;
+}
+
+export interface ToolingStatus {
+  ok: boolean;
+  swanctl: boolean;
+  xl2tpd: boolean;
+  xl2tpdControlSocket: boolean;
+  detail: string;
+}
+
+export type CommandRunner = (
+  cmd: string,
+  args: string[],
+) => Promise<{ code: number; stdout: string; stderr: string }>;
+
+const CONF_DIR = process.env.L2TP_CLIENT_DIR || '/etc/uplinko/l2tp';
+const SWAN_CONF_D = `${CONF_DIR}/swanctl/conf.d`;
+const XL2TPD_CTL = process.env.XL2TPD_CONTROL_SOCKET || '/var/run/xl2tpd/l2tp-control';
+
+// Bounded retry ceilings (defect 9) — saved settings can never exceed these.
+const MAX_RETRIES = 10;
+const MAX_RETRY_DELAY_SEC = 60;
+const MAX_TIMEOUT_SEC = 120;
+
+@Injectable()
+export class L2tpClientDialer {
+  private readonly logger = new Logger('L2tpClientDialer');
+
+  run: CommandRunner = (cmd, args) =>
+    new Promise((resolve) => {
+      execFile(cmd, args, { timeout: 30_000 }, (err, stdout, stderr) => {
+        resolve({
+          code: err && typeof (err as any).code === 'number' ? (err as any).code : err ? 1 : 0,
+          stdout: String(stdout || ''),
+          stderr: String(stderr || ''),
+        });
+      });
+    });
+
+  // Overridable for tests. Always enforces 0600 even when the file already exists.
+  writeSecretFile: (path: string, data: string) => Promise<void> = async (path, data) => {
+    await fs.mkdir(SWAN_CONF_D, { recursive: true, mode: 0o700 });
+    await fs.chmod(CONF_DIR, 0o700).catch(() => undefined);
+    await fs.writeFile(path, data, { mode: 0o600 });
+    await fs.chmod(path, 0o600); // re-assert on overwrite (writeFile mode only applies on create)
+  };
+
+  // ── validation (defect 7) ──────────────────────────────────────────────
+  private connName(id: string): string {
+    if (!/^[A-Za-z0-9_-]{1,48}$/.test(id)) throw new Error('Invalid connection id');
+    return 'uplinko-' + id;
+  }
+  private validHost(h: string): boolean {
+    if (!h || h.length > 255) return false;
+    return /^[A-Za-z0-9.:_-]+$/.test(h); // IPv4/IPv6/hostname chars only — no spaces/newlines/config breakers
+  }
+  private validUser(u: string): boolean {
+    return !!u && u.length <= 128 && /^[A-Za-z0-9._@-]+$/.test(u);
+  }
+  private validAddr(a?: string): boolean {
+    if (!a) return true;
+    return a.length <= 64 && /^[A-Za-z0-9.:/_-]+$/.test(a);
+  }
+  private validParams(p: DialParams): string | null {
+    if (!this.validHost(p.server)) return 'Invalid NAS host/IP.';
+    if (!this.validUser(p.pppUsername)) return 'Invalid PPP username.';
+    if (!p.ipsecPsk || /[\n\r"]/.test(p.ipsecPsk)) return 'Invalid IPsec pre-shared key.';
+    if (!p.pppPassword || /[\n\r"]/.test(p.pppPassword)) return 'Invalid PPP password.';
+    if (!this.validAddr(p.localAddress)) return 'Invalid local address.';
+    return null;
+  }
+
+  // ── tooling / daemon presence (defect: missing tools + control socket) ──
+  async tooling(): Promise<ToolingStatus> {
+    const has = async (bin: string) =>
+      (await this.run('which', [bin]).catch(() => ({ code: 1 } as any))).code === 0;
+    const swanctl = await has('swanctl');
+    const xl2tpd = await has('xl2tpd');
+    // The control socket is what xl2tpd-control operates; without a running
+    // daemon there is no socket and we must not pretend we can dial.
+    const sock = await this.run('test', ['-S', XL2TPD_CTL]).catch(() => ({ code: 1 } as any));
+    const xl2tpdControlSocket = sock.code === 0;
+    const ok = swanctl && xl2tpd && xl2tpdControlSocket;
+    const missing = [
+      !swanctl && 'strongSwan (swanctl)',
+      !xl2tpd && 'xl2tpd',
+      !xl2tpdControlSocket && 'xl2tpd control socket (daemon not running)',
+    ].filter(Boolean);
+    return {
+      ok, swanctl, xl2tpd, xl2tpdControlSocket,
+      detail: ok ? 'Host VPN client tooling present.' : `Missing: ${missing.join(', ')}.`,
+    };
+  }
+
+  async isSupported(): Promise<boolean> {
+    return (await this.tooling()).ok;
+  }
+
+  // ── config writers ─────────────────────────────────────────────────────
+  private async writeConfig(p: DialParams, name: string): Promise<void> {
+    // swanctl connection — loaded by `swanctl --load-all` from conf.d (defect 1)
+    const swan = `connections {
+  ${name} {
+    version = 1
+    proposals = aes256-sha1-modp1024,3des-sha1-modp1024,default
+    local_addrs = %any
+    remote_addrs = ${p.server}
+    local { auth = psk }
+    remote { auth = psk }
+    children {
+      ${name} {
+        mode = transport
+        local_ts = dynamic[udp/l2tp]
+        remote_ts = dynamic[udp/l2tp]
+        esp_proposals = aes256-sha1,3des-sha1,default
+        start_action = none
+      }
+    }
+  }
+}
+`;
+    const secrets = `secrets {
+  ike-${name} {
+    secret = "${p.ipsecPsk}"
+  }
+}
+`;
+    await this.writeSecretFile(`${SWAN_CONF_D}/${name}.conf`, swan);
+    await this.writeSecretFile(`${SWAN_CONF_D}/${name}.secrets`, secrets);
+
+    // pppd options for THIS lac (referenced by xl2tpd-control add) (defect 2)
+    const ppp = `name "${p.pppUsername}"
+password "${p.pppPassword}"
+refuse-eap
+require-mschap-v2
+noccp
+noauth
+idle 0
+lcp-echo-interval 20
+lcp-echo-failure 3
+ipparam ${name}
+`;
+    await this.writeSecretFile(`${CONF_DIR}/${name}.ppp`, ppp);
+  }
+
+  // ── dial with bounded retry + cleanup (defects 3,4,6,9) ─────────────────
+  async dial(p: DialParams): Promise<DialStatus> {
+    const tooling = await this.tooling();
+    if (!tooling.ok) return { state: 'error', error: tooling.detail };
+
+    const invalid = this.validParams(p);
+    if (invalid) return { state: 'error', error: invalid };
+
+    const name = this.connName(p.connectionId);
+    const retries = Math.min(Math.max(0, p.retryCount ?? 0), MAX_RETRIES);
+    const delayMs = Math.min(Math.max(1, p.retryDelaySec ?? 5), MAX_RETRY_DELAY_SEC) * 1000;
+    const timeoutSec = Math.min(Math.max(5, p.timeoutSec ?? 20), MAX_TIMEOUT_SEC);
+
+    let last: DialStatus = { state: 'error', error: 'Dial not attempted.' };
+    for (let attempt = 0; attempt <= retries; attempt++) {
+      last = await this.attempt(p, name, timeoutSec);
+      if (last.state === 'connected') return last;
+      // Clean up a partial tunnel before retrying or giving up (defect 6).
+      await this.teardown(name);
+      if (attempt < retries) await new Promise((r) => setTimeout(r, delayMs));
+    }
+    return last;
+  }
+
+  private async attempt(p: DialParams, name: string, timeoutSec: number): Promise<DialStatus> {
+    try {
+      await this.writeConfig(p, name);
+      const load = await this.run('swanctl', ['--load-all']);
+      if (load.code !== 0) return { state: 'error', error: 'strongSwan failed to load the connection config.' };
+
+      const up = await this.run('swanctl', ['--initiate', '--ike', name, '--child', name]);
+      if (up.code !== 0) return { state: 'error', ipsec: 'down', error: this.classifyIpsecError(up.stderr || up.stdout) };
+
+      // Add + connect the LAC on the running xl2tpd (defect 2).
+      await this.run('xl2tpd-control', ['-c', XL2TPD_CTL, 'add', name,
+        `lns=${p.server}`, `pppoptfile=${CONF_DIR}/${name}.ppp`, 'length bit=yes']);
+      const con = await this.run('xl2tpd-control', ['-c', XL2TPD_CTL, 'connect', name]);
+      if (con.code !== 0) return { state: 'error', ipsec: 'established', l2tp: 'down', error: 'L2TP session could not be started.' };
+
+      const deadline = Date.now() + timeoutSec * 1000;
+      while (Date.now() < deadline) {
+        const st = await this.status(p.connectionId);
+        if (st.state === 'connected' || st.state === 'error') return st;
+        await new Promise((r) => setTimeout(r, 1000));
+      }
+      return { state: 'connecting', detail: 'Tunnel not established within timeout.' };
+    } catch (e: any) {
+      return { state: 'error', error: 'Dialer failure: ' + String(e?.message || e).slice(0, 120) };
+    }
+  }
+
+  async hangup(connectionId: string): Promise<DialStatus> {
+    const name = this.connName(connectionId);
+    await this.teardown(name);
+    return { state: 'disconnected', ipsec: 'down', l2tp: 'down' };
+  }
+
+  private async teardown(name: string): Promise<void> {
+    await this.run('xl2tpd-control', ['-c', XL2TPD_CTL, 'disconnect', name]).catch(() => undefined);
+    await this.run('xl2tpd-control', ['-c', XL2TPD_CTL, 'remove', name]).catch(() => undefined);
+    await this.run('swanctl', ['--terminate', '--ike', name]).catch(() => undefined);
+  }
+
+  /**
+   * Real, connection-SPECIFIC evidence (defects 3,4): the IPsec SA for THIS ike
+   * name must be established, AND this LAC's own ppp interface must be up.
+   */
+  async status(connectionId: string): Promise<DialStatus> {
+    const tooling = await this.tooling();
+    if (!tooling.ok) return { state: 'error', error: tooling.detail };
+    const name = this.connName(connectionId);
+
+    // `--ike <name>` scopes the listing to THIS connection only, so ESTABLISHED
+    // here is specific to it (defect 3). An empty/other listing is not evidence.
+    const sa = await this.run('swanctl', ['--list-sas', '--ike', name]).catch(() => ({ code: 1, stdout: '', stderr: '' }));
+    const ipsecEstablished = sa.code === 0 && sa.stdout.includes(name) && /ESTABLISHED/i.test(sa.stdout);
+
+    // This LAC's session + its ppp interface — never a foreign ppp device.
+    const sess = await this.run('xl2tpd-control', ['-c', XL2TPD_CTL, 'status', name]).catch(() => ({ code: 1, stdout: '', stderr: '' }));
+    const ifMatch = sess.stdout.match(/\b(ppp\d+)\b/);
+    const iface = sess.code === 0 && ifMatch ? ifMatch[1] : null;
+
+    if (!ipsecEstablished) {
+      return { state: 'disconnected', ipsec: 'down', l2tp: iface ? 'up' : 'down' };
+    }
+    if (!iface) {
+      return { state: 'connecting', ipsec: 'established', l2tp: 'down', detail: 'IPsec SA up; L2TP session negotiating.' };
+    }
+    // Verify the interface is operationally UP (not merely present) (defect 4).
+    const link = await this.run('ip', ['-o', 'link', 'show', 'dev', iface]).catch(() => ({ code: 1, stdout: '', stderr: '' }));
+    if (link.code !== 0) {
+      return { state: 'connecting', ipsec: 'established', l2tp: 'down', interface: iface, detail: 'L2TP interface not yet present.' };
+    }
+    const up = /state (UP|UNKNOWN)/i.test(link.stdout) || /[<,]UP[,>]/.test(link.stdout) || /LOWER_UP/.test(link.stdout);
+    if (!up) {
+      return { state: 'connecting', ipsec: 'established', l2tp: 'down', interface: iface, detail: 'L2TP interface present but down.' };
+    }
+    // Assigned addresses, if ip reports them.
+    const addr = await this.run('ip', ['-o', '-4', 'addr', 'show', 'dev', iface]).catch(() => ({ code: 1, stdout: '', stderr: '' }));
+    const local = addr.stdout.match(/inet\s+([0-9.]+)/)?.[1] ?? null;
+    const peer = addr.stdout.match(/peer\s+([0-9.]+)/)?.[1] ?? null;
+    return {
+      state: 'connected', interface: iface, localAddress: local, remoteAddress: peer,
+      ipsec: 'established', l2tp: 'up',
+      detail: 'IPsec SA established; L2TP interface up.',
+    };
+  }
+
+  private classifyIpsecError(out: string): string {
+    if (/AUTHENTICATION_FAILED|pre-shared key|no shared key|PSK/i.test(out))
+      return 'IPsec negotiation failed — pre-shared key mismatch.';
+    if (/no route|unreachable|timeout|retransmit|NO_PROPOSAL|received NO_PROPOSAL/i.test(out))
+      return 'NAS unreachable or IPsec negotiation timed out.';
+    return 'IPsec connection failed.';
+  }
+}
diff --git a/backend/src/nas/l2tp-client-dialer.spec.ts b/backend/src/nas/l2tp-client-dialer.spec.ts
new file mode 100644
index 0000000..17f7baf
--- /dev/null
+++ b/backend/src/nas/l2tp-client-dialer.spec.ts
@@ -0,0 +1,203 @@
+import { L2tpClientDialer } from './l2tp-client-dialer.service';
+
+/**
+ * Dialer regression tests. The host command runner and secret writer are
+ * injected, so no real VPN stack is touched. These prove the corrected
+ * behaviour: the daemons actually load/operate the config, status is specific
+ * to the connection, and nothing reports "connected" without real evidence.
+ */
+
+type Resp = { code?: number; stdout?: string; stderr?: string };
+
+function makeDialer(responder: (cmd: string, args: string[]) => Resp) {
+  const d = new L2tpClientDialer();
+  const calls: { cmd: string; args: string[] }[] = [];
+  const written: { path: string; data: string }[] = [];
+  d.run = async (cmd, args) => {
+    calls.push({ cmd, args });
+    const r = responder(cmd, args) || {};
+    return { code: r.code ?? 0, stdout: r.stdout ?? '', stderr: r.stderr ?? '' };
+  };
+  d.writeSecretFile = async (path, data) => { written.push({ path, data }); };
+  return { d, calls, written };
+}
+
+// Default: all tooling present.
+function toolingOk(cmd: string, args: string[]): Resp | null {
+  if (cmd === 'which') return { code: 0, stdout: '/usr/sbin/' + args[0] };
+  if (cmd === 'test' && args[0] === '-S') return { code: 0 };
+  return null;
+}
+
+const P = {
+  connectionId: 'nas-7',
+  server: '203.0.113.9',
+  ipsecPsk: 'super-secret-psk',
+  pppUsername: 'uplinko-mgmt',
+  pppPassword: 'ppp-pass-xyz',
+  timeoutSec: 2,
+};
+
+// A fully-up connection for connection "uplinko-nas-7" on ppp5.
+function happy(cmd: string, args: string[]): Resp {
+  const t = toolingOk(cmd, args); if (t) return t;
+  if (cmd === 'swanctl' && args[0] === '--load-all') return { code: 0 };
+  if (cmd === 'swanctl' && args[0] === '--initiate') return { code: 0, stdout: 'initiate completed successfully' };
+  if (cmd === 'xl2tpd-control' && args.includes('add')) return { code: 0 };
+  if (cmd === 'xl2tpd-control' && args.includes('connect')) return { code: 0 };
+  if (cmd === 'swanctl' && args[0] === '--list-sas') return { code: 0, stdout: 'uplinko-nas-7: #1, ESTABLISHED, IKEv1\n  uplinko-nas-7: INSTALLED' };
+  if (cmd === 'xl2tpd-control' && args.includes('status')) return { code: 0, stdout: 'session for uplinko-nas-7 on ppp5 established' };
+  if (cmd === 'ip' && args.includes('link')) return { code: 0, stdout: '5: ppp5: <POINTOPOINT,MULTICAST,NOARP,UP,LOWER_UP> state UNKNOWN' };
+  if (cmd === 'ip' && args.includes('addr')) return { code: 0, stdout: 'inet 10.80.0.2 peer 10.80.0.1/32 scope global ppp5' };
+  return { code: 0 };
+}
+
+describe('L2tpClientDialer (corrected)', () => {
+  it('errors (not connected) when tooling or the xl2tpd control socket is missing', async () => {
+    const { d } = makeDialer((cmd, args) => {
+      if (cmd === 'which') return { code: 0 };
+      if (cmd === 'test' && args[0] === '-S') return { code: 1 }; // no control socket
+      return {};
+    });
+    const st = await d.dial(P);
+    expect(st.state).toBe('error');
+    expect(st.error).toMatch(/control socket|not running|Missing/i);
+  });
+
+  it('loads config into the daemons and connects only with scoped IPsec SA + UP ppp iface', async () => {
+    const { d, calls } = makeDialer(happy);
+    const st = await d.dial(P);
+    expect(st.state).toBe('connected');
+    expect(st.interface).toBe('ppp5');
+    expect(st.localAddress).toBe('10.80.0.2');
+    // strongSwan actually loaded the config (defect 1).
+    expect(calls.some((c) => c.cmd === 'swanctl' && c.args[0] === '--load-all')).toBe(true);
+    // xl2tpd actually operated the LAC (defect 2).
+    expect(calls.some((c) => c.cmd === 'xl2tpd-control' && c.args.includes('add') && c.args.includes('uplinko-nas-7'))).toBe(true);
+    expect(calls.some((c) => c.cmd === 'xl2tpd-control' && c.args.includes('connect'))).toBe(true);
+    // SA listing was scoped to this connection (defect 3).
+    expect(calls.some((c) => c.cmd === 'swanctl' && c.args[0] === '--list-sas' && c.args.includes('uplinko-nas-7'))).toBe(true);
+  });
+
+  it('does not treat a foreign ppp interface as evidence (status reads THIS lac only)', async () => {
