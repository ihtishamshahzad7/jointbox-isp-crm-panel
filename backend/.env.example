# Database Configuration → WSL (localhost)
# connection_limit/pool_timeout = Phase 0 pooling (pgBouncer-ready: add &pgbouncer=true when behind pgBouncer)
DATABASE_URL="postgresql://jointbox:jointbox123@localhost:5432/jointbox?connection_limit=10&pool_timeout=15"

# RADIUS Database URL - same jointbox DB in WSL
RADIUS_DATABASE_URL="postgresql://jointbox:jointbox123@localhost:5432/jointbox"

# Admin DB URL - used once for ownership fix (postgres superuser)
ADMIN_DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/jointbox"

# RADIUS Server Configuration → WSL running FreeRADIUS
RADIUS_SERVER_IP="localhost"
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813

# Admin credentials — must match prisma/seed.ts
ADMIN_EMAIL=admin@jointbox.com
ADMIN_PASSWORD=admin123

# JWT Secret - MUST be the same in auth.module.ts and jwt.strategy.ts
JWT_SECRET=jb-prod-jwt-secret-20260724-a1b2c3d4e5f6g7h8

# Server Port
PORT=3001

# Node Environment
NODE_ENV=development

# Phase 0: optional Redis. When set, cache + BullMQ queues switch on automatically.
# Without it the app still runs (in-memory cache + inline jobs).
# REDIS_URL="redis://localhost:6379"

# Phase 2: SMS gateway (generic HTTP). {phone} and {message} are replaced automatically.
# Unset = simulated mode (messages logged, marked SIMULATED — safe for testing).
# SMS_GATEWAY_URL="https://your-sms-provider.com/send?apikey=XXX&to={phone}&text={message}"
# SMS_GATEWAY_METHOD=GET
# SMS_GATEWAY_BODY={"to":"{phone}","message":"{message}"}

# Phase 2: SMTP email. Unset = simulated mode.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# SMTP_FROM="Jointbox <no-reply@jointbox.net>"

# Phase 2: expiry reminder days before expiry (comma-separated)
# EXPIRY_REMINDER_DAYS=3,1,0

# Phase 3: payment gateways. SANDBOX is auto-enabled in development (fake checkout, end-to-end testable).
# Public URLs used in gateway redirects (set to your real domain in production):
# BACKEND_PUBLIC_URL=http://localhost:3001
# FRONTEND_PUBLIC_URL=http://localhost:3000
# GATEWAY_CURRENCY=BDT

# Stripe: STRIPE_SECRET_KEY=sk_test_...
# bKash:  BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
#         BKASH_APP_KEY=... BKASH_APP_SECRET=... BKASH_USERNAME=... BKASH_PASSWORD=...
# SSLCommerz: SSLCZ_STORE_ID=... SSLCZ_STORE_PASS=... SSLCZ_SANDBOX=1
CORS_ORIGIN=*

CONSOLE_SHELL_ENABLED=true
