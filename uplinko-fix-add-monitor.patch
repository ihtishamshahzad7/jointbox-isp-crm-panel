@@ -0,0 +1,50 @@
+/**
+ * Bug fix — "Add monitor doesn't work".
+ *
+ * Root cause: create() called assertDestination() which HARD-FAILS when the
+ * backend cannot resolve the hostname via DNS (common on an on-prem panel with
+ * no outbound DNS for the Node process). Adding any host by NAME threw
+ * SsrfBlocked("DNS lookup failed"), so the add silently failed.
+ *
+ * Fix: monitor create/update tolerate an unresolved name (allowUnresolved) — the
+ * device is added and reported unreachable until it answers — while a name that
+ * RESOLVES to a forbidden address (loopback / metadata) is still blocked, and
+ * HTTP/TCP checks stay strict.
+ */
+jest.mock('../prisma/prisma.service', () => ({ PrismaService: class {} }));
+import { MonitoringService } from './monitoring.service';
+import { assertDestination } from '../security/outbound-guard';
+
+function svc() {
+  const prisma: any = { monitorTarget: { create: async ({ data }: any) => ({ id: 1, ...data }) } };
+  const scope: any = { actorId: () => 1, isAdmin: () => false, descendantIds: async () => [1], rootId: async () => 1 };
+  return new MonitoringService(prisma, scope, { broadcast: () => {} } as any, {} as any);
+}
+const actor: any = { sub: 1, id: 1, role: 'ADMIN' };
+
+describe('Add monitor (bug fix)', () => {
+  it('adds a private-IP ICMP monitor', async () => {
+    const r: any = await svc().create({ host: '192.168.7.9', name: 'gateway', groupName: 'Core' }, actor);
+    expect(r).toMatchObject({ host: '192.168.7.9', name: 'gateway', checkType: 'ICMP', ownerId: 1 });
+  });
+
+  it('adds a hostname even when the backend cannot resolve DNS (the bug)', async () => {
+    // .invalid never resolves (RFC 2606), so this reproduces the DNS failure
+    // that used to block the add. It must now succeed.
+    const r: any = await svc().create({ host: 'router.example.invalid', name: 'tower-7' }, actor);
+    expect(r).toMatchObject({ host: 'router.example.invalid', checkType: 'ICMP' });
+  });
+
+  it('still rejects an empty host', async () => {
+    await expect(svc().create({ host: '' }, actor)).rejects.toThrow(/host/i);
+  });
+
+  it('still rejects a malformed host', async () => {
+    await expect(svc().create({ host: 'has spaces/and?junk' }, actor)).rejects.toThrow(/invalid/i);
+  });
+
+  it('SSRF still blocked: a literal loopback/metadata address is refused even with allowUnresolved', async () => {
+    await expect(assertDestination('127.0.0.1', 'OPERATOR_NETWORK', { allowUnresolved: true })).rejects.toThrow(/loopback/i);
+    await expect(assertDestination('169.254.169.254', 'OPERATOR_NETWORK', { allowUnresolved: true })).rejects.toThrow(/metadata|link-local/i);
+  });
+});
