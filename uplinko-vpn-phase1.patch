+    if (!nas?.nasIp || !nas?.apiUsername || !nas?.apiPassword) {
+      throw new BadRequestException(
+        'Set this NAS IP and RouterOS API credentials before configuring the management VPN.',
+      );
+    }
+    return {
+      host: String(nas.nasIp),
+      port: Number(nas.apiPort) || 8728,
+      username: String(nas.apiUsername),
+      password: decField(this.secrets, nas.apiPassword),
+    };
+  }
+
+  /** Persist panel client credentials (secrets encrypted; never echoed back). */
+  async saveClientConfig(
+    nasId: number,
+    actor: any,
+    input: {
+      publicHost?: string;
+      pppUsername?: string;
+      pppPassword?: string;
+      ipsecPsk?: string;
+      pppProfile?: string;
+      localAddress?: string;
+      remoteAddress?: string;
+      connectTimeoutSec?: number;
+      retryCount?: number;
+      retryDelaySec?: number;
+    },
+  ) {
+    await this.ensureAccess(nasId, actor);
+    const userId = this.getActorUserId(actor);
+    const data: any = { nasId, updatedById: userId };
+    if (input.publicHost !== undefined) data.publicHost = input.publicHost || null;
+    if (input.pppUsername !== undefined) data.pppUsername = input.pppUsername || null;
+    if (input.pppProfile !== undefined) data.pppProfile = input.pppProfile || null;
+    if (input.localAddress !== undefined) data.localAddress = input.localAddress || null;
+    if (input.remoteAddress !== undefined) data.remoteAddress = input.remoteAddress || null;
+    if (input.connectTimeoutSec !== undefined) data.connectTimeoutSec = input.connectTimeoutSec;
+    if (input.retryCount !== undefined) data.retryCount = input.retryCount;
+    if (input.retryDelaySec !== undefined) data.retryDelaySec = input.retryDelaySec;
+    if (input.pppPassword !== undefined) data.pppPasswordEnc = input.pppPassword ? this.secrets.encryptValue(input.pppPassword) : null;
+    if (input.ipsecPsk !== undefined) data.ipsecPskEnc = input.ipsecPsk ? this.secrets.encryptValue(input.ipsecPsk) : null;
+    await this.prisma.nasL2tpConfig.upsert({
+      where: { nasId },
+      create: { ...data, createdById: userId },
+      update: data,
+    });
+    return this.getClientView(nasId, actor);
+  }
+
+  /** Masked client view — no secrets ever leave this method. */
+  async getClientView(nasId: number, actor: any) {
+    await this.ensureAccess(nasId, actor);
+    const row = await this.prisma.nasL2tpConfig.findUnique({ where: { nasId } });
+    return {
+      nasId,
+      direction: 'Uplinko Panel → NAS Public IP',
+      publicHost: row?.publicHost ?? null,
+      pppUsername: row?.pppUsername ?? null,
+      hasPppPassword: !!row?.pppPasswordEnc,
+      hasIpsecPsk: !!row?.ipsecPskEnc,
+      pppProfile: row?.pppProfile ?? null,
+      localAddress: row?.localAddress ?? null,
+      remoteAddress: row?.remoteAddress ?? null,
+      connectTimeoutSec: row?.connectTimeoutSec ?? 20,
+      clientState: row?.clientState ?? 'disconnected',
+      tunnelInterface: row?.tunnelInterface ?? null,
+      lastDialAt: row?.lastDialAt ?? null,
+      lastConnectedAt: row?.lastConnectedAt ?? null,
+      lastDisconnectedAt: row?.lastDisconnectedAt ?? null,
+      lastTunnelState: row?.lastTunnelState ?? null,
+      lastClientError: row?.lastClientError ?? null,
+      lastAppliedAt: row?.lastAppliedAt ?? null,
+    };
+  }
+
+  /**
+   * Configure the NAS-side L2TP/IPsec SERVER and the dedicated panel PPP secret
+   * (service=l2tp) over the RouterOS API, confirming each setting by reading it
+   * back. Never reports applied unless the NAS confirms.
+   */
+  async applyServerToNas(nasId: number, actor: any) {
+    const nas = await this.ensureAccess(nasId, actor);
+    const row = await this.prisma.nasL2tpConfig.findUnique({ where: { nasId } });
+    const psk = row?.ipsecPskEnc ? this.secrets.decryptValue(row.ipsecPskEnc) : null;
+    const pppUser = row?.pppUsername || null;
+    const pppPass = row?.pppPasswordEnc ? this.secrets.decryptValue(row.pppPasswordEnc) : null;
+    if (!psk || !pppUser || !pppPass) {
+      throw new BadRequestException(
+        'Set the IPsec pre-shared secret and the dedicated PPP username/password before applying to the NAS.',
+      );
+    }
+    const api = this.nasApi(nas);
+    const profile = row?.pppProfile || 'default';
+    try {
+      const confirmed = await withMikrotik(
+        { ...api, timeout: 12000 },
+        async (client) => {
+          // 1. Enable the L2TP server with IPsec protection.
+          await client.send([
+            '/interface/l2tp-server/server/set',
+            '=enabled=yes',
+            '=use-ipsec=required',
+            `=ipsec-secret=${psk}`,
+            '=authentication=mschap2',
+            `=default-profile=${profile}`,
+          ]);
+          // 2. Create or update the dedicated PPP secret (service=l2tp).
+          const existing = await client.send(['/ppp/secret/print', `?name=${pppUser}`]);
+          const id = existing?.[0]?.['.id'];
+          const attrs = [
+            `=password=${pppPass}`,
+            '=service=l2tp',
+            `=profile=${profile}`,
+            ...(row?.remoteAddress ? [`=remote-address=${row.remoteAddress}`] : []),
+            ...(row?.localAddress ? [`=local-address=${row.localAddress}`] : []),
+          ];
+          if (id) {
+            await client.send(['/ppp/secret/set', `=.id=${id}`, ...attrs]);
+          } else {
+            await client.send(['/ppp/secret/add', `=name=${pppUser}`, ...attrs]);
+          }
+          // 3. Read back to CONFIRM — never claim applied otherwise.
+          const server = await client.send(['/interface/l2tp-server/server/print']);
+          const secret = await client.send(['/ppp/secret/print', `?name=${pppUser}`]);
+          const serverEnabled = /yes|true/i.test(String(server?.[0]?.enabled ?? ''));
+          const ipsecOn = /required|yes/i.test(String(server?.[0]?.['use-ipsec'] ?? ''));
+          const secretOk = (secret?.[0]?.service ?? '') === 'l2tp' && (secret?.[0]?.name ?? '') === pppUser;
+          return { serverEnabled, ipsecOn, secretOk };
+        },
+      );
+      if (!confirmed.serverEnabled || !confirmed.secretOk) {
+        await this.recordApply(nasId, userId(actor), false, 'NAS did not confirm the L2TP server or PPP secret.');
+        throw new BadRequestException('NAS did not confirm the configuration was applied.');
+      }
+      await this.recordApply(nasId, userId(actor), true, null);
+      return { applied: true, confirmed };
+    } catch (e: any) {
+      if (e instanceof BadRequestException) throw e;
+      await this.recordApply(nasId, userId(actor), false, String(e?.message || e).slice(0, 400));
+      throw new BadRequestException('Could not reach or configure the NAS over RouterOS API.');
+    }
+  }
+
+  private async recordApply(nasId: number, uid: number | null, ok: boolean, err: string | null) {
+    await this.prisma.nasL2tpConfig.update({
+      where: { nasId },
+      data: {
+        lastAppliedAt: ok ? new Date() : undefined,
+        state: ok ? 'active' : 'failed',
+        lastError: err,
+        updatedById: uid,
+      },
+    });
+  }
+
+  /** Dial the NAS public IP from the panel; verify a real tunnel before success. */
+  async connectClient(nasId: number, actor: any) {
+    await this.ensureAccess(nasId, actor);
+    const row = await this.prisma.nasL2tpConfig.findUnique({ where: { nasId } });
+    const psk = row?.ipsecPskEnc ? this.secrets.decryptValue(row.ipsecPskEnc) : null;
+    const pppPass = row?.pppPasswordEnc ? this.secrets.decryptValue(row.pppPasswordEnc) : null;
+    if (!row?.publicHost || !row?.pppUsername || !pppPass || !psk) {
+      throw new BadRequestException('Set NAS public host, PPP username/password and IPsec secret before connecting.');
+    }
+    await this.prisma.nasL2tpConfig.update({
+      where: { nasId },
+      data: { clientState: 'connecting', lastDialAt: new Date(), lastClientError: null },
+    });
+    const status = await this.dialer.dial({
+      connectionId: this.connId(nasId),
+      server: row.publicHost,
+      ipsecPsk: psk,
+      pppUsername: row.pppUsername,
+      pppPassword: pppPass,
+      localAddress: row.localAddress ?? undefined,
+      timeoutSec: row.connectTimeoutSec ?? 20,
+    });
+    return this.persistClientStatus(nasId, status);
+  }
+
+  async disconnectClient(nasId: number, actor: any) {
+    await this.ensureAccess(nasId, actor);
+    const status = await this.dialer.hangup(this.connId(nasId));
+    await this.prisma.nasL2tpConfig.update({
+      where: { nasId },
+      data: { clientState: 'disconnected', lastDisconnectedAt: new Date(), tunnelInterface: null },
+    });
+    return { ...status };
+  }
+
+  async reconnectClient(nasId: number, actor: any) {
+    await this.disconnectClient(nasId, actor);
+    return this.connectClient(nasId, actor);
+  }
+
+  /** Live client status from real tunnel evidence, persisted for diagnostics. */
+  async clientStatus(nasId: number, actor: any) {
+    await this.ensureAccess(nasId, actor);
+    const status = await this.dialer.status(this.connId(nasId));
+    return this.persistClientStatus(nasId, status);
+  }
+
+  private async persistClientStatus(nasId: number, status: DialStatus) {
+    await this.prisma.nasL2tpConfig.update({
+      where: { nasId },
+      data: {
+        clientState: status.state,
+        tunnelInterface: status.interface ?? undefined,
+        lastTunnelState: (status.detail ?? status.error ?? null)?.slice(0, 500) ?? null,
+        lastClientError: status.state === 'error' ? (status.error ?? 'error')?.slice(0, 500) : null,
+        lastConnectedAt: status.state === 'connected' ? new Date() : undefined,
+      },
+    });
+    return { state: status.state, interface: status.interface ?? null, detail: status.detail ?? null, error: status.error ?? null };
+  }
+}
+
+function userId(actor: any): number | null {
+  const raw = actor?.sub ?? actor?.id ?? null;
+  return raw == null ? null : Number(raw);
 }
diff --git a/backend/src/nas/nas-l2tp-management.spec.ts b/backend/src/nas/nas-l2tp-management.spec.ts
new file mode 100644
index 0000000..d128f8c
--- /dev/null
+++ b/backend/src/nas/nas-l2tp-management.spec.ts
@@ -0,0 +1,146 @@
+/**
+ * Management-VPN service tests — correct architecture (panel = L2TP/IPsec client,
+ * NAS = server). RouterOS and the host dialer are mocked; no DB or network.
+ *
+ * Proven here:
+ *  - NAS-side apply creates the dedicated PPP secret with service=l2tp and only
+ *    reports applied when the NAS confirms (read-back).
+ *  - The panel dials the NAS public IP (connect uses publicHost).
+ *  - Invalid/missing credentials are rejected before any device call.
+ *  - Secrets (IPsec PSK, PPP password) are never returned in API views.
+ */
+
+// Stop the real Prisma client (and its native engine) from loading.
+jest.mock('../prisma/prisma.service', () => ({ PrismaService: class {} }));
+
+let lastSent: string[][] = [];
+let rosResponder: (words: string[]) => any[] = () => [];
+jest.mock('./mikrotik.client', () => ({
+  withMikrotik: async (_cfg: any, fn: any) =>
+    fn({
+      send: async (words: string[]) => {
+        lastSent.push(words);
+        return rosResponder(words);
+      },
+    }),
+}));
+
+import { NasL2tpConfigService } from './nas-l2tp-config.service';
+
+const ACTOR = { sub: 1, role: 'ADMIN' };
+
+function build(configRow: any, dialer?: any) {
+  lastSent = [];
+  const nas = {
+    id: 7, ownerId: 1, nasname: 'r1', nasIp: '203.0.113.9', nasIdentifier: 'r1',
+    apiPort: 8728, apiUsername: 'admin', apiPassword: 'enc:pw', apiEnabled: true, isActive: true,
+  };
+  const row = { ...configRow };
+  const prisma = {
+    nas: { findUnique: async () => nas },
+    nasL2tpConfig: {
+      findUnique: async () => row,
+      update: async ({ data }: any) => Object.assign(row, data),
+      upsert: async ({ update }: any) => Object.assign(row, update),
+    },
+  };
+  const scope = {
+    assertNas: async () => undefined,
+    isPlatformOwner: () => false,
+    actorId: () => 1,
+  };
+  const secrets = {
+    encryptValue: (v: string) => `enc:${v}`,
+    decryptValue: (v: string) => (v?.startsWith('enc:') ? v.slice(4) : v),
+  };
+  const vpn = {};
+  const dial = dialer ?? { dial: jest.fn(), hangup: jest.fn(), status: jest.fn() };
+  const svc = new NasL2tpConfigService(prisma as any, scope as any, secrets as any, vpn as any, dial as any);
+  return { svc, prisma, row, dial };
+}
+
+const READY_ROW = {
+  nasId: 7, publicHost: '203.0.113.9', pppUsername: 'uplinko-mgmt',
+  pppPasswordEnc: 'enc:ppp-pass', ipsecPskEnc: 'enc:psk-123', pppProfile: 'default',
+  connectTimeoutSec: 20, clientState: 'disconnected',
+};
+
+describe('NasL2tpConfigService — management VPN (panel is the client)', () => {
+  it('applies the NAS server + dedicated PPP secret (service=l2tp) and confirms by read-back', async () => {
+    rosResponder = (w) => {
+      if (w[0] === '/ppp/secret/print') return []; // not existing yet → add path
+      if (w[0] === '/interface/l2tp-server/server/print') return [{ enabled: 'yes', 'use-ipsec': 'required' }];
+      return [];
+    };
+    // second print (read-back of the secret) must confirm service=l2tp:
+    let printCount = 0;
+    rosResponder = (w) => {
+      if (w[0] === '/interface/l2tp-server/server/print') return [{ enabled: 'yes', 'use-ipsec': 'required' }];
+      if (w[0] === '/ppp/secret/print') {
+        printCount += 1;
+        return printCount === 1 ? [] : [{ '.id': '*1', name: 'uplinko-mgmt', service: 'l2tp' }];
+      }
+      return [];
+    };
+    const { svc } = build(READY_ROW);
+    const res = await svc.applyServerToNas(7, ACTOR);
+    expect(res.applied).toBe(true);
+    // A PPP secret was added with service=l2tp.
+    const add = lastSent.find((w) => w[0] === '/ppp/secret/add');
+    expect(add).toBeTruthy();
+    expect(add).toEqual(expect.arrayContaining(['=service=l2tp', '=name=uplinko-mgmt']));
+    // L2TP server was enabled with IPsec.
+    const srv = lastSent.find((w) => w[0] === '/interface/l2tp-server/server/set');
+    expect(srv).toEqual(expect.arrayContaining(['=enabled=yes', '=use-ipsec=required']));
+  });
+
+  it('does NOT claim applied when the NAS fails to confirm', async () => {
+    rosResponder = (w) => {
+      if (w[0] === '/interface/l2tp-server/server/print') return [{ enabled: 'no' }];
+      if (w[0] === '/ppp/secret/print') return [];
+      return [];
+    };
+    const { svc } = build(READY_ROW);
+    await expect(svc.applyServerToNas(7, ACTOR)).rejects.toThrow(/did not confirm/i);
+  });
+
+  it('rejects apply when IPsec PSK or PPP credentials are missing', async () => {
+    const { svc } = build({ ...READY_ROW, ipsecPskEnc: null });
+    await expect(svc.applyServerToNas(7, ACTOR)).rejects.toThrow(/pre-shared secret|PPP/i);
+  });
+
+  it('connect dials the NAS PUBLIC IP (not the reverse) and persists verified state', async () => {
+    const dialer = {
+      dial: jest.fn().mockResolvedValue({ state: 'connected', interface: 'ppp5', detail: 'up' }),
+      hangup: jest.fn(), status: jest.fn(),
+    };
+    const { svc, row } = build(READY_ROW, dialer);
+    const res = await svc.connectClient(7, ACTOR);
+    expect(dialer.dial).toHaveBeenCalledWith(expect.objectContaining({ server: '203.0.113.9', pppUsername: 'uplinko-mgmt' }));
+    expect(res.state).toBe('connected');
+    expect(row.clientState).toBe('connected');
+  });
+
+  it('connect is rejected when client credentials are incomplete', async () => {
+    const { svc } = build({ ...READY_ROW, pppPasswordEnc: null });
+    await expect(svc.connectClient(7, ACTOR)).rejects.toThrow(/PPP username\/password|IPsec/i);
+  });
+
+  it('getClientView never returns secrets, only has-flags, and states the direction', async () => {
+    const { svc } = build(READY_ROW);
+    const view: any = await svc.getClientView(7, ACTOR);
+    expect(view.direction).toMatch(/Panel → NAS Public IP/);
+    expect(view.hasPppPassword).toBe(true);
+    expect(view.hasIpsecPsk).toBe(true);
+    expect(JSON.stringify(view)).not.toContain('psk-123');
+    expect(JSON.stringify(view)).not.toContain('ppp-pass');
+  });
+
+  it('disconnect tears the tunnel down via the dialer', async () => {
+    const dialer = { dial: jest.fn(), hangup: jest.fn().mockResolvedValue({ state: 'disconnected' }), status: jest.fn() };
+    const { svc, row } = build(READY_ROW, dialer);
+    await svc.disconnectClient(7, ACTOR);
+    expect(dialer.hangup).toHaveBeenCalledWith('nas-7');
+    expect(row.clientState).toBe('disconnected');
+  });
+});
