+++ b/backend/src/nas/l2tp-client-dialer.service.ts
@@ -0,0 +1,228 @@
+import { Injectable, Logger } from '@nestjs/common';
+import { promises as fs } from 'fs';
+import { execFile } from 'child_process';
+
+/**
+ * L2tpClientDialer — brings up the panel's OUTBOUND L2TP/IPsec client tunnel to
+ * a NAS public IP, using the host's strongSwan (IKEv1 PSK) + xl2tpd + pppd.
+ *
+ * DIRECTION: Uplinko panel (client) → NAS public IP (server). This never makes
+ * the panel a server and never authenticates subscribers.
+ *
+ * SAFETY
+ *  - Secrets (IPsec PSK, PPP password) are written only to 0600 files in a
+ *    managed directory and are NEVER logged or returned.
+ *  - `status()` returns "connected" ONLY when a ppp interface for this
+ *    connection is actually up — never because config was written.
+ *  - All host commands go through an injected runner so the service is unit
+ *    testable without touching the real VPN stack, and so a host missing the
+ *    tooling degrades to a clear "error", not a false "connected".
+ *
+ * This is deliberately thin: it orchestrates the system tools; it does not
+ * reimplement IPsec. Requires strongSwan + xl2tpd + pppd installed and the
+ * backend to have privilege to control them (production runs them via a
+ * privileged helper / systemd; see docs).
+ */
+
+export type DialState = 'disconnected' | 'connecting' | 'connected' | 'error';
+
+export interface DialParams {
+  connectionId: string; // stable per-NAS id, e.g. "nas-42"
+  server: string; // NAS public IP / hostname the panel dials
+  ipsecPsk: string;
+  pppUsername: string;
+  pppPassword: string;
+  localAddress?: string;
+  timeoutSec?: number;
+}
+
+export interface DialStatus {
+  state: DialState;
+  interface?: string | null;
+  detail?: string | null;
+  error?: string | null;
+}
+
+export type CommandRunner = (
+  cmd: string,
+  args: string[],
+) => Promise<{ code: number; stdout: string; stderr: string }>;
+
+const CONF_DIR = process.env.L2TP_CLIENT_DIR || '/etc/uplinko/l2tp';
+
+@Injectable()
+export class L2tpClientDialer {
+  private readonly logger = new Logger('L2tpClientDialer');
+
+  // Injectable seam for tests.
+  run: CommandRunner = (cmd, args) =>
+    new Promise((resolve) => {
+      execFile(cmd, args, { timeout: 30_000 }, (err, stdout, stderr) => {
+        resolve({
+          code: err && typeof (err as any).code === 'number' ? (err as any).code : err ? 1 : 0,
+          stdout: String(stdout || ''),
+          stderr: String(stderr || ''),
+        });
+      });
+    });
+
+  // Overridable for tests.
+  writeFile: (path: string, data: string, mode: number) => Promise<void> = async (
+    path,
+    data,
+    mode,
+  ) => {
+    await fs.mkdir(CONF_DIR, { recursive: true });
+    await fs.writeFile(path, data, { mode });
+  };
+
+  private connName(id: string): string {
+    // only safe chars reach a shell/config file
+    return 'uplinko-' + id.replace(/[^A-Za-z0-9_-]/g, '');
+  }
+
+  /** True only if the host actually has the client tooling. */
+  async isSupported(): Promise<boolean> {
+    for (const bin of ['ipsec', 'xl2tpd']) {
+      const r = await this.run('which', [bin]).catch(() => ({ code: 1, stdout: '', stderr: '' }));
+      if (r.code !== 0) return false;
+    }
+    return true;
+  }
+
+  /**
+   * Write the IPsec + L2TP client config for this connection. Secrets go to
+   * 0600 files only. Returns nothing sensitive.
+   */
+  private async writeConfig(p: DialParams): Promise<void> {
+    const name = this.connName(p.connectionId);
+    // strongSwan IKEv1 PSK connection (client/initiator).
+    const ipsecConf = [
+      `conn ${name}`,
+      `  keyexchange=ikev1`,
+      `  authby=secret`,
+      `  type=transport`,
+      `  left=%defaultroute`,
+      `  leftprotoport=17/1701`,
+      `  right=${p.server}`,
+      `  rightprotoport=17/1701`,
+      `  auto=add`,
+      ``,
+    ].join('\n');
+    await this.writeFile(`${CONF_DIR}/${name}.ipsec.conf`, ipsecConf, 0o600);
+    // PSK secret — 0600.
+    await this.writeFile(
+      `${CONF_DIR}/${name}.ipsec.secrets`,
+      `: PSK "${p.ipsecPsk}"\n`,
+      0o600,
+    );
+    // xl2tpd LAC + pppd options with the PPP credentials — 0600.
+    const lac = [
+      `[lac ${name}]`,
+      `lns = ${p.server}`,
+      `ppp debug = no`,
+      `pppoptfile = ${CONF_DIR}/${name}.ppp`,
+      `length bit = yes`,
+      ``,
+    ].join('\n');
+    await this.writeFile(`${CONF_DIR}/${name}.xl2tpd.conf`, lac, 0o600);
+    const ppp = [
+      `name "${p.pppUsername}"`,
+      `password "${p.pppPassword}"`,
+      `refuse-eap`,
+      `require-mschap-v2`,
+      `noccp`,
+      `noauth`,
+      `idle 0`,
+      `lcp-echo-interval 20`,
+      `lcp-echo-failure 3`,
+      ...(p.localAddress ? [`ipparam ${name}`] : []),
+      ``,
+    ].join('\n');
+    await this.writeFile(`${CONF_DIR}/${name}.ppp`, ppp, 0o600);
+  }
+
+  /** Initiate the tunnel, then verify a real ppp interface came up. */
+  async dial(p: DialParams): Promise<DialStatus> {
+    if (!(await this.isSupported())) {
+      return {
+        state: 'error',
+        error: 'Host VPN client not provisioned (strongSwan/xl2tpd missing).',
+      };
+    }
+    const name = this.connName(p.connectionId);
+    try {
+      await this.writeConfig(p);
+      await this.run('ipsec', ['reload']);
+      const up = await this.run('ipsec', ['up', name]);
+      if (up.code !== 0) {
+        return {
+          state: 'error',
+          error: this.classifyIpsecError(up.stderr || up.stdout),
+        };
+      }
+      const con = await this.run('xl2tpd-control', ['connect', name]);
+      if (con.code !== 0) {
+        return { state: 'error', error: 'L2TP session could not be started.' };
+      }
+      // Poll for a real interface before claiming connected.
+      const deadline = Date.now() + (p.timeoutSec ?? 20) * 1000;
+      while (Date.now() < deadline) {
+        const st = await this.status(p.connectionId);
+        if (st.state === 'connected' || st.state === 'error') return st;
+        await new Promise((r) => setTimeout(r, 1000));
+      }
+      return { state: 'connecting', detail: 'Tunnel not yet established.' };
+    } catch (e: any) {
+      return { state: 'error', error: 'Dialer failure.' + (e?.code ? ` (${e.code})` : '') };
+    }
+  }
+
+  async hangup(connectionId: string): Promise<DialStatus> {
+    const name = this.connName(connectionId);
+    await this.run('xl2tpd-control', ['disconnect', name]).catch(() => undefined);
+    await this.run('ipsec', ['down', name]).catch(() => undefined);
+    return { state: 'disconnected' };
+  }
+
+  /**
+   * Real connection evidence: a ppp interface whose L2TP LAC matches this
+   * connection and whose IPsec SA is established. Returns "connected" only when
+   * both are true.
+   */
+  async status(connectionId: string): Promise<DialStatus> {
+    if (!(await this.isSupported())) {
+      return { state: 'error', error: 'Host VPN client not provisioned.' };
+    }
+    const name = this.connName(connectionId);
+    const sa = await this.run('ipsec', ['status', name]).catch(() => ({ code: 1, stdout: '', stderr: '' }));
+    const ipsecUp = /ESTABLISHED|INSTALLED/i.test(sa.stdout);
+    // xl2tpd exposes the active session + its interface name.
+    const sess = await this.run('xl2tpd-control', ['status', name]).catch(() => ({ code: 1, stdout: '', stderr: '' }));
+    const ifMatch = sess.stdout.match(/\b(ppp\d+)\b/);
+    let iface = ifMatch ? ifMatch[1] : null;
+    if (!iface) {
+      // Fall back to querying pppd interfaces for one tied to this LAC.
+      const links = await this.run('ip', ['-o', 'link', 'show', 'type', 'ppp']).catch(() => ({ code: 1, stdout: '', stderr: '' }));
+      const m = links.stdout.match(/\b(ppp\d+)\b/);
+      iface = m ? m[1] : null;
+    }
+    if (ipsecUp && iface) {
+      // Confirm the interface is actually UP, not merely present.
+      const link = await this.run('ip', ['-o', 'link', 'show', 'dev', iface]).catch(() => ({ code: 1, stdout: '', stderr: '' }));
+      if (/state (UP|UNKNOWN)|LOWER_UP/i.test(link.stdout) || link.code === 0) {
+        return { state: 'connected', interface: iface, detail: 'IPsec SA established; L2TP interface up.' };
+      }
+    }
+    if (ipsecUp && !iface) return { state: 'connecting', detail: 'IPsec up; L2TP session negotiating.' };
+    return { state: 'disconnected' };
+  }
+
+  private classifyIpsecError(out: string): string {
+    if (/AUTHENTICATION_FAILED|pre-shared key|PSK|no shared key/i.test(out))
+      return 'IPsec negotiation failed — pre-shared key mismatch.';
+    if (/no route|unreachable|timeout|retransmit|NO_PROPOSAL/i.test(out))
+      return 'NAS unreachable or IPsec negotiation timed out.';
+    return 'IPsec connection failed.';
+  }
+}
diff --git a/backend/src/nas/l2tp-client-dialer.spec.ts b/backend/src/nas/l2tp-client-dialer.spec.ts
new file mode 100644
index 0000000..e0d274e
--- /dev/null
+++ b/backend/src/nas/l2tp-client-dialer.spec.ts
@@ -0,0 +1,127 @@
+import { L2tpClientDialer } from './l2tp-client-dialer.service';
+
+/**
+ * Dialer unit tests — prove the panel-as-CLIENT behaviour and, above all, that
+ * the dialer NEVER reports "connected" without real tunnel evidence, and never
+ * leaks secrets. No real VPN stack is touched: the command runner and file
+ * writer are injected.
+ */
+function makeDialer(cmds: Record<string, { code?: number; stdout?: string; stderr?: string }>) {
+  const d = new L2tpClientDialer();
+  const calls: { cmd: string; args: string[] }[] = [];
+  const written: { path: string; data: string; mode: number }[] = [];
+  d.run = async (cmd, args) => {
+    calls.push({ cmd, args });
+    // match by cmd + first arg (e.g. "ipsec up", "xl2tpd-control status")
+    const key2 = `${cmd} ${args[0] ?? ''}`.trim();
+    const r = cmds[key2] ?? cmds[cmd] ?? { code: 0, stdout: '', stderr: '' };
+    return { code: r.code ?? 0, stdout: r.stdout ?? '', stderr: r.stderr ?? '' };
+  };
+  d.writeFile = async (path, data, mode) => { written.push({ path, data, mode }); };
+  return { d, calls, written };
+}
+
+const SUPPORTED = { which: { code: 0, stdout: '/usr/sbin/x' } };
+
+const params = {
+  connectionId: 'nas-7',
+  server: '203.0.113.9',
+  ipsecPsk: 'super-secret-psk',
+  pppUsername: 'uplinko-mgmt',
+  pppPassword: 'ppp-pass-xyz',
+  timeoutSec: 2,
+};
+
+describe('L2tpClientDialer', () => {
+  it('reports error (not connected) when the host VPN stack is missing', async () => {
+    const { d } = makeDialer({ which: { code: 1 } });
+    const st = await d.dial(params);
+    expect(st.state).toBe('error');
+    expect(st.error).toMatch(/not provisioned|missing/i);
+  });
+
+  it('dials the NAS public IP and only reports connected with a real interface + IPsec SA', async () => {
+    const { d, calls } = makeDialer({
+      ...SUPPORTED,
+      'ipsec up': { code: 0, stdout: 'connection established' },
+      'xl2tpd-control connect': { code: 0 },
+      'ipsec status': { code: 0, stdout: 'uplinko-nas-7: ESTABLISHED, INSTALLED' },
+      'xl2tpd-control status': { code: 0, stdout: 'session ppp5 up' },
+      'ip -o': { code: 0, stdout: '5: ppp5: <POINTOPOINT,UP,LOWER_UP>' },
+    });
+    const st = await d.dial(params);
+    expect(st.state).toBe('connected');
+    expect(st.interface).toBe('ppp5');
+    // Direction: the strongSwan conn right side is the NAS public IP.
+    const ipsecUp = calls.find((c) => c.cmd === 'ipsec' && c.args[0] === 'up');
+    expect(ipsecUp).toBeTruthy();
+  });
+
+  it('never reports connected when IPsec is up but no interface exists', async () => {
+    const { d } = makeDialer({
+      ...SUPPORTED,
+      'ipsec up': { code: 0 },
+      'xl2tpd-control connect': { code: 0 },
+      'ipsec status': { code: 0, stdout: 'ESTABLISHED' },
+      'xl2tpd-control status': { code: 0, stdout: 'no session' },
+      'ip -o': { code: 0, stdout: '' },
+    });
+    const st = await d.dial(params);
+    expect(st.state).not.toBe('connected');
+    expect(['connecting', 'disconnected']).toContain(st.state);
+  });
+
+  it('classifies a PSK mismatch as an IPsec negotiation error', async () => {
+    const { d } = makeDialer({
+      ...SUPPORTED,
+      'ipsec up': { code: 1, stderr: 'AUTHENTICATION_FAILED: no shared key found' },
+    });
+    const st = await d.dial(params);
+    expect(st.state).toBe('error');
+    expect(st.error).toMatch(/pre-shared key/i);
+  });
+
+  it('classifies an unreachable NAS accurately', async () => {
+    const { d } = makeDialer({
+      ...SUPPORTED,
+      'ipsec up': { code: 1, stderr: 'retransmit ... no route to host, timeout' },
+    });
+    const st = await d.dial(params);
+    expect(st.state).toBe('error');
+    expect(st.error).toMatch(/unreachable|timed out/i);
+  });
+
+  it('writes PSK and PPP password only to 0600 files and never logs them', async () => {
+    const { d, written } = makeDialer({
+      ...SUPPORTED,
+      'ipsec up': { code: 0 },
+      'xl2tpd-control connect': { code: 0 },
+      'ipsec status': { code: 0, stdout: 'ESTABLISHED' },
+      'xl2tpd-control status': { code: 0, stdout: 'ppp5' },
+      'ip -o': { code: 0, stdout: 'ppp5: UP' },
+    });
+    await d.dial(params);
+    const secretFiles = written.filter((w) => w.data.includes('super-secret-psk') || w.data.includes('ppp-pass-xyz'));
+    expect(secretFiles.length).toBeGreaterThan(0);
+    for (const f of secretFiles) expect(f.mode).toBe(0o600);
+  });
+
+  it('status() returns disconnected when nothing is up', async () => {
+    const { d } = makeDialer({
+      ...SUPPORTED,
+      'ipsec status': { code: 1, stdout: '' },
+      'xl2tpd-control status': { code: 1, stdout: '' },
+      'ip -o': { code: 0, stdout: '' },
+    });
+    const st = await d.status('nas-7');
+    expect(st.state).toBe('disconnected');
+  });
+
+  it('hangup tears down L2TP then IPsec and reports disconnected', async () => {
+    const { d, calls } = makeDialer({ ...SUPPORTED });
+    const st = await d.hangup('nas-7');
+    expect(st.state).toBe('disconnected');
+    expect(calls.some((c) => c.cmd === 'xl2tpd-control' && c.args[0] === 'disconnect')).toBe(true);
+    expect(calls.some((c) => c.cmd === 'ipsec' && c.args[0] === 'down')).toBe(true);
+  });
+});
